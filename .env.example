# Optionnel : clé Claude pour rédiger les briefs par canal (sinon gabarit P4 sans IA)
ANTHROPIC_API_KEY=

# Optionnel : figer la date du jour pour rejouer un calcul passé (AAAA-MM-JJ)
# DEMO_TODAY=2026-09-23

# Connexion (Railway > Variables). Sans APP_PASSWORD, l'application reste ouverte.
APP_USER=
APP_PASSWORD=
# Clé de signature des sessions : une longue chaîne aléatoire (ex. openssl rand -hex 32)
SESSION_SECRET=
